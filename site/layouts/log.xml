<rss version="2.0">
	<channel>
		<title :text="$site.title.suffix(' changelog')"></title>
		<link :text="$site.host_url.addPath($page.link())"></link>
		<description :text="$site.custom.get('description')"></description>
		<generator>Zine -- https://zine-ssg.io</generator>
		<language>en-us</language>
		<lastBuildDate :text="$build.generated.formatHTTP()"></lastBuildDate>
		<ctx :loop="$page.contentSections()">
			<ctx :if="$loop.it.id.eql('about').not()">
			<item>
				<title :text="$loop.it.id"></title>
				<pubDate :text="$loop.it.data.get('date').parseDate().formatHTTP()"></pubDate>
				<link :text="$site.host_url.addPath($page.link()).suffix('#', $loop.it.id)"></link>
				<guid :text="$site.host_url.addPath($page.link()).suffix('#', $loop.it.id)"></guid>
				<description :text="$loop.it.html()"></description>
			</item>
			</ctx>
		</ctx>
	</channel>
</rss>
